@import "tailwindcss";

:root {
  color-scheme: dark;
  --ps-bg: #070b14;
  --ps-panel: #0d1424;
  --ps-line: #1c2740;
}

html, body { background: var(--ps-bg); }

body {
  color: #e6ecf7;
  font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  -webkit-font-smoothing: antialiased;
  background-image:
    radial-gradient(1000px 500px at 12% -10%, rgba(56,189,248,.10), transparent 60%),
    radial-gradient(800px 400px at 92% 0%, rgba(244,63,94,.08), transparent 60%);
  background-attachment: fixed;
}

.panel {
  background: linear-gradient(180deg, rgba(20,29,49,.85), rgba(11,17,30,.85));
  border: 1px solid var(--ps-line);
  border-radius: 16px;
}

.mono { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; }

@keyframes ps-scan { 0% { transform: translateY(-100%) } 100% { transform: translateY(400%) } }
.scanline { animation: ps-scan 1.4s ease-in-out infinite; }

@keyframes ps-pop { from { opacity: 0; transform: translateY(8px) } to { opacity: 1; transform: none } }
.pop { animation: ps-pop .45s cubic-bezier(.22,1,.36,1) both; }

::-webkit-scrollbar { width: 10px; height: 10px; }
::-webkit-scrollbar-thumb { background: #243149; border-radius: 8px; }
::-webkit-scrollbar-track { background: transparent; }
