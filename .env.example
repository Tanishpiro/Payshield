# Server-only. Never put these values in NEXT_PUBLIC_ variables or the APK.
ELEVENLABS_API_KEY=
# Copy a voice ID from your ElevenLabs voice library.
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# Private prototype access code (at least 24 characters); enter this in the APK.
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
PAYSHIELD_VOICE_ACCESS_TOKEN=
# Additional allowed browser origins, comma separated. Android uses https://localhost.
PAYSHIELD_VOICE_ALLOWED_ORIGINS=https://localhost
